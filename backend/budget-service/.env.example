# JWT_SECRET must be identical in every service. Generate with: python scripts/setup_env.py
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_long_random_secret
# Where the Notification Service lives. 127.0.0.1 = same machine; in Docker use the service name.
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8006
DOWNSTREAM_TIMEOUT_SECONDS=2
